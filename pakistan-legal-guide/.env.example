# Copy to .env.local for local development. Everything here is PUBLIC once built —
# never put API keys or secrets in a VITE_ variable.

# Optional: HTTPS URL of your own serverless proxy for the AI assistant (Mode B).
# Leave empty to use only the offline local search assistant.
VITE_AI_ENDPOINT=
VITE_AI_PROVIDER_NAME=

# Optional: absolute base path. Default "./" works for any GitHub Pages URL.
# VITE_BASE_PATH=/pakistan-legal-guide/
